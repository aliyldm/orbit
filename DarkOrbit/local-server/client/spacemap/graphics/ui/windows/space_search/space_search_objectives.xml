<?xml version="1.0" encoding="UTF-8"?>
<root>
    <skin name="sae_shop_scrollbar_bg" classname="FadableButtonSkin">
        <layer classname="FilledBoxLayer" fillColor="0x0" fillAlpha="0.3">normal</layer>
    </skin>
    <!-- TEMPLATES -->
    <template name="space_search_objectives">
        <container name="tabbarContainer"
                   autoSizeWidth="true" autoWidthMode="parent" autoSizeHeight="true" autoHeightMode="parent">
            <itemlist   name="tabsItemlist"
                        width="200" height="17"
                        alignX="right" marginRight="-7"
                        layout="horizontal"  itemGap="0"
                        mouseEnabled="true" mouseChildren="true"
                        cacheSkinMaskAsBitmap="false" registeredSkinName="commonui_list_mask">
                <itemrenderer width="100" height="17" autoSizeWidth="false"
                              mouseEnabled="true" mouseChildren="true">
                    <button name="tab"
                            autoSizeWidth="true" autoSizeHeight="true"
                            mouseEnabled="true" mouseChildren="true"
                            registeredSkinName="commonui_tabbarbutton"/>
                    <button name="tab_selected" visible="false"
                            autoSizeWidth="true"  autoSizeHeight="true"
                            mouseEnabled="true" mouseChildren="true"
                            registeredSkinName="commonui_tabbarbutton"/>
                    <label  name="tabLabel" text="?"
                            autoSizeWidth="true" height="15" alignY="center"
                            mouseEnabled="false" mouseChildren="false"
                            registeredTextStyleName="commonui_tabbar_center"  registeredSkinName="commonui_default_label"/>

                    <coreponent
                            name="redDot"
                            width = "8"
                            height = "8"
                            autoSizeWidth="false"
                            autoSizeHeight="false"
                            alignX="right"
                            alignY="center"
                            marginX="4"

                    />
<!--                    registeredSkinName="commonui_darklayer" -->
                </itemrenderer>
            </itemlist>

            <button name="clearButton" width="16" height="16" registeredSkinName="commonui_spinbox_button_arrow_lef" visible="true" />
        </container>
    </template>
    <container name="root" width="500" height="634" autoSizeWidth="false" autoSizeHeight="false" mouseEnabled="false"
               mouseChilderen="true">
        <reference template="space_search_objectives"/>
    </container>

</root>
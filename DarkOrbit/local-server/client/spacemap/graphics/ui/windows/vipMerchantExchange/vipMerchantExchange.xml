								<coreponent name="vertical_divider_2" width="1" height="80" alignX="right" marginRight="205"/>

								<container  name="cost"
											width="190" height="80" autoSizeWidth="false" autoSizeHeight="false"
											alignX="right" marginRight="10">

									<label  name="item_1"
											width="50" height="10" autoSizeWidth="false" autoSizeHeight="false"
											alignX="left"

<?xml version="1.0" encoding="UTF-8"?>

<root>
	<!-- LIBS -->
	<libraries>
		<library id="gameclientCommonUI"/>
		<library id="battlePass"/>
	</libraries>

	<!-- TEXT STYLES -->
	<textstyle  name="vipmerchexchange_description"
				textColor="0xffffff"
				type="dynamic"
				fontSize="11"
				autoSize="right"
				wordWrap="true"
				multiline="true"
				embedFonts="false"
				fontName="Verdana"
				align="left"/>

	<textstyle  name="vipmerchexchange_pack"
				textColor="0xff9900"
				type="dynamic"
				fontSize="10"
				autoSize="left"
				wordWrap="false"
				multiline="false"
				embedFonts="false"
				fontName="Verdana"
				align="left"/>

	<textstyle  name="vipmerchexchange_timer"
				textColor="0xff9900"
				type="dynamic"
				fontSize="11"
				autoSize="center"
				wordWrap="false"
				multiline="false"
				embedFonts="false"
				fontName="Verdana"
				align="center"/>

	<textstyle  name="vipmerchexchange_header"
				textColor="0xffffff"
				type="dynamic"
				fontSize="10"
				autoSize="left"
				wordWrap="false"
				multiline="false"
				embedFonts="false"
				fontName="Verdana"
				bold="true"
				align="left"/>

	<textstyle  name="vipmerchexchange_item_description"
				textColor="0xffffff"
				type="dynamic"
				fontSize="10"
				autoSize="right"
				wordWrap="true"
				multiline="true"
				embedFonts="false"
				fontName="Verdana"
				bold="false"
				align="left"/>

	<textstyle  name="vipmerchexchange_item_limit"
				textColor="0xffffff"
				type="dynamic"
				fontSize="10"
				autoSize="left"
				wordWrap="false"
				multiline="false"
				embedFonts="false"
				fontName="Verdana"
				bold="false"
				align="left"/>

	<textstyle  name="vipmerchexchange_cost_left"
				textColor="0xffffff"
				type="dynamic"
				fontSize="10"
				autoSize="left"
				wordWrap="false"
				multiline="false"
				embedFonts="false"
				fontName="Verdana"
				bold="false"
				align="left"/>

	<textstyle  name="vipmerchexchange_cost_right"
				textColor="0xffffff"
				type="dynamic"
				fontSize="10"
				autoSize="right"
				wordWrap="false"
				multiline="false"
				embedFonts="false"
				fontName="Verdana"
				align="right"/>

	<!-- SKIN -->
	<skin name="vip_merchant_exchange_list_outline" classname="BasicSkin">
		<layer classname="FilledBoxLayer" fillColor="0x0" fillAlpha="0" lineColor="0x37687F" lineAlpha="1">normal</layer>
	</skin>

	<skin name="vip_merchant_exchange_scrollbar_bg" classname="FadableButtonSkin">
		<layer classname="FilledBoxLayer" fillColor="0x0" fillAlpha="0.3">normal</layer>
	</skin>

	<skin name="vip_merchant_commonui_yellowlayer" classname="BasicSkin">
		<layer classname="FilledBoxLayer"  fillColor="0x999900" fillAlpha="0.3"  >normal</layer>
	</skin>

	<skin name="vip_merchant_exchange_icon_bg" classname="BasicSkin" library="battlePass">
		<layer classname="BitmapLayer" libraryID="item_bg">normal</layer>
	</skin>

	<skin name="vip_merchant_exchange_icon_bg_special" classname="BasicSkin" library="battlePass">
		<layer classname="BitmapLayer" libraryID="item_bg_yellow">normal</layer>
	</skin>

	<skin name="vip_merchant_exchange_icon_btn" classname="FadableButtonSkin">
		<layer classname="FilledBoxLayer" fillColor="0x0" fillAlpha="0">normal</layer>
	</skin>

	<skin name="vip_merchant_exchange_description_bg" classname="BasicSkin" library="battlePass">
		<layer classname="BitmapLayer" libraryID="frame_bp-exchange_blue">normal</layer>
	</skin>

	<skin name="vip_merchant_exchange_description_bg_special" classname="BasicSkin" library="battlePass">
		<layer classname="BitmapLayer" libraryID="frame_bp-exchange_yellow">normal</layer>
	</skin>

	<skin name="vip_merchant_exchange_maxed_bg" classname="BasicSkin">
		<layer classname="FilledBoxLayer" fillColor="0x0" fillAlpha="0.7" lineColor="0" lineAlpha="0">normal</layer>
	</skin>

	<template name="VIP_MERCHANT_EXCHANGE">
		<container  name="overview"
					width="540" height="600" autoSizeWidth="false" autoSizeHeight="false"
					alignX="center" marginTop="10">

			<container  name="unavailable"
						width="540" height="600" autoSizeWidth="false" autoSizeHeight="false">

				<container  name="top"
							width="490" height="170" autoSizeWidth="false" autoSizeHeight="false"
							alignX="center">

					<label  text="localize:window_vip-exchange_description_before"
							width="490"  height="30" autoSizeWidth="false" autoSizeHeight="false"
							alignX="left"
							registeredTextStyleName="vipmerchexchange_description" registeredSkinName="commonui_default_label"/>

					<label  text="localize:window_vip-exchange_packs"
							width="490"  height="10" autoSizeWidth="false" autoSizeHeight="false"
							alignX="left" marginTop="40"
							registeredTextStyleName="vipmerchexchange_description" registeredSkinName="commonui_default_label"/>

					<container  name="packs"
								autoSizeWidth="true" autoWidthMode="parent" height="60" autoSizeHeight="false"
								marginTop="60"
								registeredSkinName="commonui_darklayer">
						<itemlist   name="pack_list"
									width="490" height="60" autoSizeWidth="false" autoSizeHeight="false"
									layout="vertical" itemGap="0"
									mouseEnabled="true" mouseChildren="true"
									cacheSkinMaskAsBitmap="false" registeredSkinName="commonui_list_mask">
							<itemrenderer width="540" height="13" autoSizeWidth="false" autoSizeHeight="false"
										  itemGap="0" mouseEnabled="false" mouseChildren="false">
								<label  name="pack" text=""
										width="490"  height="10" autoSizeWidth="false" autoSizeHeight="false"
										alignX="left"
										registeredTextStyleName="vipmerchexchange_pack" registeredSkinName="commonui_default_label"/>
							</itemrenderer>
						</itemlist>
						<scrollbar name="scroll_bar"
								   width="5" autoSizeHeight="true" direction="vertical"
								   marginTop="0" marginBottom="0" marginRight="0" alignX="right"
								   registeredSkinName="vip_merchant_exchange_scrollbar_bg">
							<button name="buttonSlider"
									width="5" height="10" alignX="center"
									registeredSkinName="commonui_scrollbar_slider"/>
						</scrollbar>
						<bind source="scroll_bar"
							  target="pack_list"
							  type="scrollcontainer"/>
					</container>

					<button name="buy_btn"
							text="localize:ttip_menu_buy_now" textMarginY="1"
							width="150" height="30" autoSizeWidth="false" autoSizeHeight="false"
							alignX="center" alignY="bottom" marginBottom="15"
							registeredSkinName="commonui_scale9_button_green"/>

					<label  name="countdown_timer" text="21d 02h 02m"
							width="540" height="10" autoSizeWidth="false" autoSizeHeight="false"
							alignX="center" alignY="bottom"
							registeredTextStyleName="vipmerchexchange_timer" registeredSkinName="commonui_default_label"/>
				</container>

				<coreponent autoSizeWidth="true" height="2" marginTop="180" registeredSkinName="commonui_horizontal_divider"/>

				<container  name="bottom"
							width="540" height="425" autoSizeWidth="false" autoSizeHeight="false"
							marginTop="190">

					<label  text="localize:window_vip-exchange_item-exchange"
							width="300"  height="10" autoSizeWidth="false" autoSizeHeight="false"
							alignX="left"
							registeredTextStyleName="vipmerchexchange_header" registeredSkinName="commonui_default_label"/>

					<label  text="localize:window_vip-exchange_cost"
							width="200"  height="10" autoSizeWidth="false" autoSizeHeight="false"
							alignX="right"
							registeredTextStyleName="vipmerchexchange_header" registeredSkinName="commonui_default_label"/>

					<container  name="exchange"
								width="540" height="400" autoSizeWidth="false" autoSizeHeight="false"
								marginTop="20">

						<itemlist   name="list"
									width="540" height="400" autoSizeWidth="false" autoSizeHeight="false"
									layout="vertical" itemGap="0"
									mouseEnabled="true" mouseChildren="true"
									cacheSkinMaskAsBitmap="false" registeredSkinName="commonui_list_mask">

							<itemrenderer width="540" height="80" autoSizeWidth="false" autoSizeHeight="false"
										  itemGap="0" mouseEnabled="true" mouseChildren="true">

								<coreponent name="bg"
											width="540" height="80" autoSizeWidth="false" autoSizeHeight="false"
											registeredSkinName="commonui_darklayer"/>

								<coreponent name="bg_special"
											width="540" height="80" autoSizeWidth="false" autoSizeHeight="false"
											registeredSkinName="vip_merchant_commonui_yellowlayer"/>


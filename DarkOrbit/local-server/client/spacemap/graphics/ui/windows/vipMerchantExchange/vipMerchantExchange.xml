									<label  name="amount_2"
											width="150" height="10" autoSizeWidth="false" autoSizeHeight="false"
											alignX="right" marginTop="12"
											registeredTextStyleName="vipmerchexchange_cost_right" registeredSkinName="commonui_default_label"/>

									<label  name="item_3"
											width="50" height="10" autoSizeWidth="false" autoSizeHeight="false"
											alignX="left" marginTop="24"
											registeredTextStyleName="vipmerchexchange_cost_left" registeredSkinName="commonui_default_label"/>

									<label  name="amount_3"
											width="150" height="10" autoSizeWidth="false" autoSizeHeight="false"
											alignX="right" marginTop="24"
											registeredTextStyleName="vipmerchexchange_cost_right" registeredSkinName="commonui_default_label"/>

									<label  name="item_4"
											width="50" height="10" autoSizeWidth="false" autoSizeHeight="false"
											alignX="left" marginTop="36"
											registeredTextStyleName="vipmerchexchange_cost_left" registeredSkinName="commonui_default_label"/>

									<label  name="amount_4"
											width="150" height="10" autoSizeWidth="false" autoSizeHeight="false"
											alignX="right" marginTop="36"

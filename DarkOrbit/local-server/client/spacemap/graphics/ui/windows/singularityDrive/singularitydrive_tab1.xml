<root>
    <libraries>
        <library id="gameclientCommonUI"/>
        <library id="miniClientReward"/>
    </libraries>
    <textstyle name="expedition_style1"
               textColor="0xF1FBEC"
               fontSize="12"
               type="dynamic"
               fontName="EurostileHeaFl"
               embedFonts="true"
               multiline="true"
               wordWrap="true"
               autoSize="left"/>
    <textstyle name="expedition_style2"
               textColor="0xF1FBEC"
               fontSize="14"
               type="dynamic"
               fontName="EurostileHeaFl"
               embedFonts="true"
               multiline="true"
               wordWrap="true"
               autoSize="left"/>

    <textstyle name="expedition_style3"
               textColor="0xF1FBEC"
               fontSize="12"
               type="dynamic"
               fontName="EurostileHeaFl"
               embedFonts="true"
               multiline="true"
               wordWrap="true"
               autoSize="right"
               align="right"/>


    <textstyle name="unlock_style"
               textColor="0xFFFFFF"
               type="dynamic"
               fontSize="12"
               wordWrap="true"
               multiline="true"
               embedFonts="false"
               fontName="Verdana"
               autoSize="left"/>

    <textstyle name="singularity_notpossible_style"
               textColor="0xCCCCCC"
               align="center"
               type="dynamic"
               fontSize="10"
               wordWrap="true"
               multiline="true"
               embedFonts="false"
               fontName="Verdana"
               autoSize="center"/>

    <skin name="reward_mark" classname="BasicSkin" library="miniClientReward">
        <layer classname="BitmapLayer" libraryID="reward_checkmark">normal</layer>
    </skin>

    <skin name="reward_slot_bg" library="gameclientCommonUI" classname="BasicSkin">
        <layer classname="BitmapLayer" libraryID="input_background_blue" scale9grid="4,4,6,5">normal</layer>
    </skin>



    <container name="root" width="530" height="590" autoSizeWidth="false" autoSizeHeight="false" mouseEnabled="false"
               mouseChildren="true">

        <container name="tab1_container" width="530" height="590" autoSizeWidth="false" autoSizeHeight="false"
                   mouseEnabled="false" marginTop="240"
                   mouseChildren="true">
            <!-- stats -->
            <container name="stats_container"
                       marginLeft="2" marginTop="0"
                       height="20"
                       width="155">

                <container name="hyperforgeStatsContainer"
                           marginLeft="20"
                           marginTop="0"
                           width="469">
                    <label name="stats" text="localize:reroll_stat" width="200"
                           registeredTextStyleName="crafting_selected_grid_item"/>
                </container>

                <Grid name="stats_grid"
                      width="310"
                      itemGapX="3"
                      itemGapY="3"
                      height="200"
                      marginLeft="20" marginTop="20"
                      cacheSkinMaskAsBitmap="false"
                      registeredSkinName="commonui_list_mask">

                    <itemrenderer width="150"
                                  height="42"
                                  autoSizeWidth="false"
                                  mouseEnabled="true"
                                  mouseChildren="true">
                        <coreponent name="ingredientListBg" autoSizeWidth="true" height="42"
                                    registeredSkinName="crafting_vertical_list_bg_skin"/>
                        <coreponent name="img" marginTop="6" marginLeft="6" width="32" height="32" alignX="left"
                                    alignY="center"/>
                        <coreponent registeredSkinName="crafting_ingridient_outline" width="31" height="31"
                                    marginTop="5" marginLeft="5" alignX="left" alignY="center"/>
                        <label name="item_stat_positive" marginLeft="55" marginTop="13" width="90" text="0"
                               alignX="left" alignY="top" registeredTextStyleName="reroll_item_desc_green"/>
                        <label name="item_stat_negative" marginLeft="55" marginTop="13" width="90" text="0"
                               alignX="left" alignY="top" registeredTextStyleName="reroll_item_desc_red"/>
                        <label name="unlock_info" marginLeft="55" marginTop="13" width="90" text="0"
                               alignX="left" alignY="top" registeredTextStyleName="unlock_style"/>
                    </itemrenderer>
                </Grid>
            </container>
            <!-- stats end -->


            <container name="upgrade_container"
                       width="155"
                       height="100" alignX="right">

                <label name="selectedItemInfoLabel"
                       width="120"
                       height="20"
                       marginLeft="1"
                       text="localize:crafting_upgrade_level_info"
                       registeredSkinName="crafting_label_truncate"
                       registeredTextStyleName="crafting_selected_grid_item"/>

                <label name="selectedItemLevel"
                       width="140"
                       height="20"
                       text="13"
                       registeredSkinName="crafting_label_truncate"
                       registeredTextStyleName="crafting_selected_grid_item_level"/>

                <container name="buff_container"
                           mouseEnabled="true"
                           height="42"
                           alignY="center"
                           width="160">

                    <coreponent name="buffListBg"
                                width="148"
                                height="42"
                                registeredSkinName="crafting_vertical_list_bg_skin"/>

                    <coreponent name="img"
                                width="32"
                                height="32"
                                marginTop="6"
                                marginLeft="6"
                                alignX="left"/>

                    <coreponent registeredSkinName="crafting_ingridient_outline"
                                width="31"
                                height="31"
                                marginTop="5"
                                marginLeft="5"
                                alignX="left"/>

                    <label height="15"
                           name="current_label"
                           alignX="left"
                           alignY="top"
                           width="45"
                           marginTop="13"
                           marginLeft="32"
                           registeredSkinName="crafting_label_truncate"
                           registeredTextStyleName="crafting_buff_current"/>

                    <label height="15"
                           alignX="left"
                           alignY="top"
                           width="5"
                           marginTop="13"
                           marginLeft="85"
                           text="|"
                           registeredSkinName="crafting_label_truncate"
                           registeredTextStyleName="crafting_ingredients"/>

                    <label height="15"
                           name="next_label"
                           alignX="right"
                           alignY="top"
                           width="55"
                           marginTop="13"
                           marginRight="15"
                           registeredSkinName="crafting_label_truncate"
                           registeredTextStyleName="crafting_buff_current"/>
                </container>
            </container>


            <container name="build_container"
                       marginTop="300"
                       marginLeft="215"
                       width="300" height="25">

                <spinbox name="spinBox" alignX="left" alignY="top"
                         type="horizontal"
                         width="100" height="16"
                         inputEnabled="true"
                         templateName="commonui.spinbox.horizontal.mathsymbols"/>

                <label name="time_label"
                       width="100"
                       alignY="top"
                       marginTop="20"
                       text="00:00:50"
                       registeredTextStyleName="crafting_timer"/>

                <button name="build_button"
                        width="140" height="25"
                        alignX="right" alignY="top" textMarginY="1"
                        text="localize:crafting_upgrade_button_ready"
                        registeredSkinName="commonui_scale9_button_blue"/>
            </container>

            <container name="building"
                       marginTop="300"
                       marginLeft="215"
                       width="300" height="25">
                <progressbar name="progressbar" alignY="top"
                             width="150" height="9"
                             registeredSkinName="crafting_window_progressbar_building_skin"/>

                <label name="time" width="150" alignY="top" marginTop="10" text="00:00:59" registeredTextStyleName="crafting_timer"/>

                <button name="btn" width="140" height="25" alignX="right" alignY="bottom" textMarginY="1"
                        text="localize:crafting_upgrade_button_skip"
                        registeredSkinName="commonui_scale9_button_blue"/>
            </container>


            <container name="collect"
                       marginTop="300"
                       marginLeft="215"
                       width="300" height="25">
                <progressbar name="progressbar" alignY="top"
                             width="150" height="9"
                             registeredSkinName="crafting_window_progressbar_building_skin"/>

                <label name="time" width="150" alignY="top" marginTop="10" registeredTextStyleName="crafting_timer"/>

                <button name="btn" width="140" height="25" alignX="right" alignY="bottom" textMarginY="1"
                        text="localize:assembly_button_collect"
                        registeredSkinName="commonui_scale9_button_green"/>
            </container>

            <container name="not_possible" alignX="center" alignY="top"
                       marginTop="240">
                <coreponent registeredSkinName="crafting_not_possible" name="img" marginTop="0"
                            marginLeft="0"   alignX="center" alignY="center"/>
                <label name="label" alignY="center" alignX="center" autoSizeTextHeight="true" width="400"
                       registeredTextStyleName="singularity_notpossible_style"/>
            </container>



            <!-- cost -->
            <container name="cost_container"
                       width="520" height="100"
                       mouseEnabled="false"
                       marginTop="170"
                       marginLeft="2">

                <label name="skipCraftingInfo"
                       width="155"  height="20"
                       marginLeft="10"
                       text="localize:crafting_skip_label_info"
                       registeredSkinName="crafting_label_truncate"
                       registeredTextStyleName="crafting_selected_grid_item"/>


                <Grid name="selectedItemRecipes"
                      marginLeft="20" marginTop="20"
                      itemGapX="6" itemGapY="3"
                      width="520" height="100"
                      cacheSkinMaskAsBitmap="false"
                      layout="grid"  itemAlignX="left"
                      registeredSkinName="commonui_list_mask">


                    <itemrenderer width="160" height="42" itemGap="0"
                                  mouseEnabled="true" autoSizeWidth="false"
                                  mouseChildren="true">

                        <container name="content"
                                   mouseEnabled="false"
                                   height="42"
                                   alignY="center"
                                   width="160">

                            <coreponent name="ingredientListBg"
                                        width="148"
                                        height="42"
                                        registeredSkinName="crafting_vertical_list_bg_skin"/>

                            <coreponent name="img"
                                        marginTop="6"
                                        marginLeft="6"
                                        width="32"
                                        height="32"
                                        alignX="left"/>

                            <coreponent registeredSkinName="crafting_ingridient_outline"
                                        width="31"
                                        height="31"
                                        marginTop="5"
                                        marginLeft="5"
                                        alignX="left"/>

                            <label name="item_name"
                                   alignX="left"
                                   alignY="top"
                                   height="10"
                                   marginTop="1"
                                   marginLeft="43"
                                   registeredTextStyleName="crafting_ingredients_item_name"/>

                            <label name="owned_amount"
                                   alignX="left"
                                   alignY="bottom"
                                   width="170"
                                   height="15"
                                   marginBottom="14"
                                   marginLeft="43"
                                   useHTML="true"
                                   registeredSkinName="crafting_label_truncate"
                                   registeredTextStyleName="crafting_ingredients"/>

                            <label name="amount"
                                   alignX="left"
                                   alignY="bottom"
                                   width="170"
                                   height="15"
                                   marginBottom="2"
                                   marginLeft="43"
                                   registeredSkinName="crafting_label_truncate"
                                   registeredTextStyleName="crafting_ingredients"/>

                            <button name="upgradeInfo"
                                    alignX="right"
                                    marginRight="15"
                                    marginTop="11"
                                    tooltipTemplateID="commonui_tooltip_html_text"
                                    registeredSkinName="commonui_info_button"/>

                            <button name="shop"
                                    alignX="right"
                                    marginRight="15"
                                    marginTop="11"
                                    tooltipTemplateID="commonui_tooltip_html_text"
                                    registeredSkinName="commonui_info_button"/>

                        </container>
                    </itemrenderer>
                </Grid>
                <scrollbar name="skip_ingredients_bar"
                           width="6"
                           height="90"
                           alignX="right"
                           alignY="top"
                           marginRight="0" buttonMode="true"
                           registeredSkinName="commonui_scrollbar_bgnd_dark">

                    <button name="buttonSlider"
                            width="4"
                            height="6"
                            alignX="center" buttonMode="true"
                            registeredSkinName="commonui_scrollbar_slider"/>

                </scrollbar>

                <bind source="skip_ingredients_bar"
                      target="selectedItemRecipes"
                      type="scrollcontainer"/>
            </container>
        </container>
        <!-- cost end  -->
    </container>

</root>

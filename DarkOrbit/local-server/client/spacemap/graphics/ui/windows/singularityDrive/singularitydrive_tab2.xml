<root>
    <libraries>
        <library id="gameclientCommonUI"/>
        <library id="SingularityDrive"/>
    </libraries>

    <textstyle name="expedition_style4"
               textColor="0xb3ab00"
               fontSize="16"
               type="dynamic"
               fontName="EurostileHeaFl"
               embedFonts="true"
               multiline="true"
               wordWrap="true"
               autoSize="left"/>

    <skin name="lock_skin" library="SingularityDrive" classname="CheckBoxSkin">
        <layer classname="BitmapLayer" libraryID="singularitydrive_lock">normal.selected</layer>
        <layer classname="BitmapLayer" libraryID="singularitydrive_unlock">normal</layer>
        <layer classname="BitmapLayer" libraryID="singularitydrive_lock">over.selected</layer>
        <layer classname="BitmapLayer" libraryID="singularitydrive_unlock">over</layer>
    </skin>

    <container name="root" width="530" height="340" autoSizeWidth="false" autoSizeHeight="false" mouseEnabled="false"
               mouseChildren="true">

        <container name="tab2_container" width="530" height="340" autoSizeWidth="false" autoSizeHeight="false"
                   mouseEnabled="false" marginTop="240"
                   mouseChildren="true">

            <!-- stats -->
            <container name="stats_container"
                       marginLeft="2" marginTop="0"
                       height="20"
                       width="155">

                <container name="hyperforgeStatsContainer"
                           marginLeft="20"
                           marginTop="0"
                           width="469">
                    <label name="stats" text="localize:reroll_stat" width="200"
                           registeredTextStyleName="crafting_selected_grid_item"/>
                </container>

                <Grid name="stats_grid"
                      width="310"
                      itemGapX="3"
                      itemGapY="3"
                      height="100"
                      marginLeft="20" marginTop="20"
                      cacheSkinMaskAsBitmap="false"
                      registeredSkinName="commonui_list_mask">

                    <itemrenderer width="150"
                                  height="42"
                                  autoSizeWidth="false"
                                  mouseEnabled="true"
                                  mouseChildren="true">
                        <coreponent name="ingredientListBg" autoSizeWidth="true" height="42"
                                    registeredSkinName="crafting_vertical_list_bg_skin"/>
                        <coreponent name="img" marginTop="6" marginLeft="6" width="32" height="32" alignX="left"
                                    alignY="center"/>
                        <coreponent registeredSkinName="crafting_ingridient_outline" width="31" height="31"
                                    marginTop="5" marginLeft="5" alignX="left" alignY="center"/>
                        <label name="item_stat_positive" marginLeft="55" marginTop="13" width="90" text="0"
                               alignX="left" alignY="top" registeredTextStyleName="reroll_item_desc_green"/>
                        <label name="item_stat_negative" marginLeft="55" marginTop="13" width="90" text="0"
                               alignX="left" alignY="top" registeredTextStyleName="reroll_item_desc_red"/>
                        <label name="unlock_info" marginLeft="55" marginTop="13" width="90" text="0"
                               alignX="left" alignY="top" registeredTextStyleName="unlock_style"/>

                        <checkbox name="lock_checkbox"
                                  alignX="left"
                                  marginLeft="110"
                                  marginTop="10"
                                  buttonMode="true"
                                  registeredSkinName="lock_skin"/>

                    </itemrenderer>
                </Grid>
            </container>
            <!-- stats end -->


            <container name="cost_container"
                       width="520" height="100"
                       mouseEnabled="false"
                       marginTop="170"
                       marginLeft="2">

                <label name="skipCraftingInfo"
                       width="155" height="20"
                       marginLeft="10"
                       text="localize:crafting_skip_label_info"
                       registeredSkinName="crafting_label_truncate"
                       registeredTextStyleName="crafting_selected_grid_item"/>


                <Grid name="selectedItemRecipes"
                      marginLeft="20" marginTop="20"
                      itemGapX="6" itemGapY="3"
                      width="520" height="100"
                      cacheSkinMaskAsBitmap="false"
                      layout="grid" itemAlignX="left"
                      registeredSkinName="commonui_list_mask">


                    <itemrenderer width="160" height="42" itemGap="0"
                                  mouseEnabled="true" autoSizeWidth="false"
                                  mouseChildren="true">

                        <container name="content"
                                   mouseEnabled="false"
                                   height="42"
                                   alignY="center"
                                   width="160">

                            <coreponent name="ingredientListBg"
                                        width="148"
                                        height="42"
                                        registeredSkinName="crafting_vertical_list_bg_skin"/>

                            <coreponent name="img"
                                        marginTop="6"
                                        marginLeft="6"
                                        width="32"
                                        height="32"
                                        alignX="left"/>

                            <coreponent registeredSkinName="crafting_ingridient_outline"
                                        width="31"
                                        height="31"
                                        marginTop="5"
                                        marginLeft="5"
                                        alignX="left"/>

                            <label name="item_name"
                                   alignX="left"
                                   alignY="top"
                                   height="10"
                                   marginTop="1"
                                   marginLeft="43"
                                   registeredTextStyleName="crafting_ingredients_item_name"/>

                            <label name="owned_amount"
                                   alignX="left"
                                   alignY="bottom"
                                   width="170"
                                   height="15"
                                   marginBottom="14"
                                   marginLeft="43"
                                   useHTML="true"
                                   registeredSkinName="crafting_label_truncate"
                                   registeredTextStyleName="crafting_ingredients"/>

                            <label name="amount"
                                   alignX="left"
                                   alignY="bottom"
                                   width="170"
                                   height="15"
                                   marginBottom="2"
                                   marginLeft="43"
                                   registeredSkinName="crafting_label_truncate"
                                   registeredTextStyleName="crafting_ingredients"/>

                            <button name="upgradeInfo"
                                    alignX="right"
                                    marginRight="15"
                                    marginTop="11"
                                    tooltipTemplateID="commonui_tooltip_html_text"
                                    registeredSkinName="commonui_info_button"/>

                            <button name="shop"
                                    alignX="right"
                                    marginRight="15"
                                    marginTop="11"
                                    tooltipTemplateID="commonui_tooltip_html_text"
                                    registeredSkinName="commonui_info_button"/>

                        </container>
                    </itemrenderer>
                </Grid>
                <scrollbar name="skip_ingredients_bar"
                           width="6"
                           height="90"
                           alignX="right"
                           alignY="top"
                           marginRight="0" buttonMode="true"
                           registeredSkinName="commonui_scrollbar_bgnd_dark">

                    <button name="buttonSlider"
                            width="4"
                            height="6"
                            alignX="center" buttonMode="true"
                            registeredSkinName="commonui_scrollbar_slider"/>

                </scrollbar>

                <bind source="skip_ingredients_bar"
                      target="selectedItemRecipes"
                      type="scrollcontainer"/>
            </container>

            <button name="btn" width="140" height="25"
                    alignX="right" alignY="bottom"
                    textMarginY="1"
                    marginBottom="20"
                    text="localize:reroll_reroll_btn"
                    registeredSkinName="commonui_scale9_button_blue"/>
        </container>
    </container>
</root>

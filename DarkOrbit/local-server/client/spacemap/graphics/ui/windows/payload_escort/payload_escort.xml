<?xml version="1.0" encoding="UTF-8"?>

<root>
    <libraries>
        <library id="gameclientCommonUI"/>
        <library id="chatWindowUIAssets"/>

    </libraries>

    <textstyle
            name="payload_escort_status_message"
            textColor="0xffe103"
            type="dynamic"
            fontSize="10"
            autoSize="right"
            wordWrap="true"
            multiline="true"
            embedFonts="false"
            fontName="Verdana"
            align="left"/>

    <textstyle
            name="payload_escort_status_timer"
            textColor="0xffe103"
            type="dynamic"
            fontSize="10"
            autoSize="right"
            wordWrap="true"
            multiline="true"
            embedFonts="false"
            fontName="Verdana"
            align="right"/>

    <textstyle
            name="payload_escort_message_left"
            textColor="0xfefefe"
            type="dynamic"
            fontSize="10"
            autoSize="right"
            wordWrap="true"
            multiline="true"
            embedFonts="false"
            fontName="Verdana"
            align="left"/>

    <textstyle
            name="payload_escort_message_center"
            textColor="0xfefefe"
            type="dynamic"
            fontSize="10"
            autoSize="right"
            wordWrap="true"
            multiline="true"
            embedFonts="false"
            fontName="Verdana"
            align="center"/>

    <textstyle
            name="payload_escort_message_right"
            textColor="0xfefefe"
            type="dynamic"
            fontSize="10"
            autoSize="right"
            wordWrap="true"
            multiline="true"
            embedFonts="false"
            fontName="Verdana"
            align="right"/>

    <textstyle
            name="payload_escort_ranking_headline"
            textColor="0xfefefe"
            type="dynamic"
            fontSize="10"
            autoSize="left"
            wordWrap="false"
            multiline="false"
            embedFonts="false"
            fontName="Verdana"
            bold="true"
            align="right"/>

    <textstyle
            name="payload_escort_rank_message"
            textColor="0xfefefe"
            type="dynamic"
            fontSize="10"
            autoSize="left"
            embedFonts="false"
            fontName="Verdana"
            align="left"/>

    <skin name="payload_escort_scrollbar_bgnd" classname="FadableButtonSkin">
        <layer classname="FilledBoxLayer" fillColor="0x0" fillAlpha="0.3">normal</layer>
    </skin>

    <skin name="payload_escort_item_outline" classname="BasicSkin">
        <layer classname="FilledBoxLayer" lineColor="0x00ccff" fillAlpha="0" lineAlpha="1">normal</layer>
    </skin>

    <skin name="payload_escort_ttip_frame" library="traininggroundsUI" classname="BasicSkin">
        <layer classname="BitmapLayer" scale9grid="1,1,2,2" libraryID="ttip_frame">normal</layer>
    </skin>

    <!-- [DARKORBIT-37183] missing skin from training ground UI. -->
    <skin name="traininggrounds_label" classname="LabelSkin" library="gameclientCommonUI"/>


    <template name="PAYLOAD_ESCORT_TABBAR">
        <container name="tabbarContainer" height="20" width="460" marginTop="0" marginLeft="0"
                   marginRight="0" pixelSnapping="true">
            <itemlist name="tabsItemlist" registeredSkinName="commonui_list_mask" layout="horizontal" alignX="right"
                      width="228" itemGap="0" height="20" mouseEnabled="true" mouseChildren="true"
                      cacheSkinMaskAsBitmap="false">
                <itemrenderer height="15" width="113" autoSizeWidth="false" mouseEnabled="true" mouseChildren="true">
                    <button name="tab" registeredSkinName="commonui_tabbarbutton" mouseEnabled="true"
                            autoSizeWidth="true" autoSizeHeight="true" mouseChildren="true"/>
                    <button name="tab_selected" registeredSkinName="commonui_tabbarbutton" mouseEnabled="true"
                            autoSizeWidth="true" visible="false" autoSizeHeight="true" mouseChildren="true"/>
                    <label y="-1" name="tabLabel" registeredSkinName="commonui_default_label"
                           registeredTextStyleName="commonui_tabbar_center" mouseEnabled="false"
                           mouseChildren="false" autoSizeWidth="true" text="?"/>
                </itemrenderer>
            </itemlist>
        </container>
    </template>

    <template name="PAYLOAD_ESCORT_OVERVIEW">
        <container name="overview" visible="false" width="420" marginLeft="20" marginRight="20" marginTop="36"
                   height="230"
                   alignX="left">
            <container name="top" width="420" marginLeft="0" marginRight="0" marginTop="0"
                       registeredSkinName="commonui_darklayer" height="140" alignX="center">
                <container name="payload_escort_status_msg" width="390" marginLeft="15" height="10" marginRight="15" alignX="left">
                    <label name="payload_escort_status_message" text="Next EM Freighter spawn: "
                           registeredTextStyleName="payload_escort_status_message"
                           marginTop="20" registeredSkinName="commonui_default_label" width="270" autoSizeTextHeight="true"/>
                    <label name="payload_escort_timer" text="testRight" registeredTextStyleName="payload_escort_status_timer" marginTop="20"
                           registeredSkinName="commonui_default_label" autoSizeWidth="true" alignX="right"/>
                    <label name="payload_escort_run_score" text="testRight" registeredTextStyleName="payload_escort_status_timer" marginTop="20"
                           marginRight="20" registeredSkinName="commonui_default_label" autoSizeWidth="true" alignX="right"/>
                    <button name="score_info" marginRight="-5" marginTop="20" alignX="right" registeredSkinName="commonui_info_button"
                            visible="false" tooltipData="localize:mimesis_mutiny_status_escorting_ttip"/>
                </container>
                <coreponent registeredSkinName="commonui_horizontal_divider" height="4" width="420" marginTop="50"/>
                <container name="payload_escort_score" width="390" marginLeft="15" height="10" marginRight="15" alignX="left" marginTop="60">
                    <label name="payload_escort_score_message" text="localize:mimesis_mutiny_tab_overview_score"
                           registeredTextStyleName="payload_escort_message_left"
                           marginTop="10" registeredSkinName="commonui_default_label" autoSizeWidth="true"/>
                    <label name="payload_escort_score_amount" text="0" registeredTextStyleName="payload_escort_message_right" marginTop="10"
                           registeredSkinName="commonui_default_label" autoSizeWidth="true" alignX="right"/>
                </container>
                <container name="payload_escort_key_info" width="390" marginLeft="15" height="30" marginTop="97" marginRight="15" alignX="left">
                    <coreponent name="escort_key_img" width="30" height="30" marginLeft="5" marginTop="-6"/>
                    <label name="payload_escort_key_message" text="localize:mimesis_mutiny_tab_overview_keys"
                           registeredTextStyleName="payload_escort_message_left" marginLeft="40"
                           registeredSkinName="commonui_default_label" autoSizeWidth="true"/>
                    <label name="payload_escort_key_amount" text="9999" registeredTextStyleName="payload_escort_message_right"
                           registeredSkinName="commonui_default_label" autoSizeWidth="true" alignX="right" marginRight="20"/>
                    <button name="keys_info" marginRight="-5" marginTop="-1" alignX="right" registeredSkinName="commonui_info_button"
                            tooltipData="localize:mimesis_mutiny_tab_overview_keys_ttip"/>
                </container>
            </container>
            <container name="bottom" width="420" marginLeft="0" marginRight="0" marginTop="155"
                       height="90" alignX="center">
                <button marginLeft="10" alignX="left" registeredSkinName="commonui_info_button" alignY="top"/>
                <label text="localize:mimesis_mutiny_tab_overview_desc"
                       registeredTextStyleName="payload_escort_message_left" alignX="left" alignY="top" marginLeft="35"
                       registeredSkinName="commonui_default_label" width="390" autoSizeTextHeight="true"/>
            </container>
        </container>
    </template>


    <template name="PAYLOAD_ESCORT_REWARDS">
        <container name="rewards" width="420" marginLeft="20" marginRight="20" marginTop="36" height="200"
                   alignX="left" registeredSkinName="commonui_darklayer">
            <coreponent registeredSkinName="commonui_horizontal_divider" height="3" width="420" marginTop="33"/>
            <container width="380" marginTop="8" alignX="center">
                <label text="localize:plutus_tab_rewards_headline"
                       registeredSkinName="commonui_default_label"
                       autoSizeWidth="true" registeredTextStyleName="payload_escort_ranking_headline"/>

            </container>
            <container name="body" width="420" marginTop="34" height="165" marginLeft="0">
                <itemlist name="payload_escort_rewardlist" width="420"
                          autoSizeHeight="true"
                          autoSizeWidth="true"
                          itemGap="0"
                          mouseChildren="true"
                          mouseEnabled="true"
                          layout="vertical"
                          cacheSkinMaskAsBitmap="false"
                          registeredSkinName="commonui_list_mask">


                    <itemrenderer width="420" autoSizeWidth="false" height="30" mouseEnabled="true"
                                  mouseChildren="true">
                        <container name="left" width="420" marginLeft="0" height="30" alignX="left">
                            <coreponent name="bg" width="420" height="30" registeredSkinName="commonui_darklayer"/>
                            <label name="place" text="test" registeredSkinName="commonui_default_label" marginTop="10"
                                   alignX="left" y="-2" x="20" width="100" registeredTextStyleName="payload_escort_message_left"/>
                            <button name="btn" registeredSkinName="commonui_info_button" marginRight="8" alignX="right"
                                    alignY="center"/>
                        </container>

                    </itemrenderer>


                </itemlist>
                <scrollbar name="payload_escort_rewardlist_scrollBar" width="5" autoSizeHeight="true" direction="vertical"
                           marginTop="0"
                           marginBottom="0"
                           marginRight="0"
                           alignX="right"
                           registeredSkinName="payload_escort_scrollbar_bgnd">
                    <button name="buttonSlider" alignX="center" width="5" height="10"
                            registeredSkinName="commonui_scrollbar_slider"/>
                </scrollbar>
                <bind source="payload_escort_rewardlist_scrollBar" target="payload_escort_rewardlist"/>
            </container>
        </container>
    </template>


    <template name="payloadEscortRewardToolTip">
        <container name="container" width="250" autoSizeHeight="true" autoHeightMode="children">
            <container name="wrapper" width="250" registeredSkinName="payload_escort_ttip_frame" autoSizeHeight="true" marginTop="20"
                       autoHeightMode="children">
                <itemlist layout="vertical" width="250" gap="0" name="list" autoSizeHeight="true" marginBottom="10"
                          autoHeightMode="children">
                    <itemrenderer height="40" marginTop="0" marginBottom="0">
                        <coreponent name="img" registeredSkinName="payload_escort_item_outline" width="30" height="30" marginTop="10" marginLeft="10"/>
                        <coreponent registeredSkinName="payload_escort_item_outline" width="31" height="31" marginTop="9" marginLeft="9"/>
                        <label name="label" width="200" alignX="left" marginLeft="50" marginTop="11"
                               height="29"
                               registeredSkinName="traininggrounds_label"
                               registeredTextStyleName="payload_escort_message_left"/>
                    </itemrenderer>
                </itemlist>
            </container>
        </container>
    </template>

    <container name="root" width="460" height="272" mouseEnabled="false" mouseChildren="true">
        <reference template="PAYLOAD_ESCORT_OVERVIEW"/>
        <reference template="PAYLOAD_ESCORT_REWARDS"/>
        <reference template="PAYLOAD_ESCORT_TABBAR"/>
    </container>
</root>


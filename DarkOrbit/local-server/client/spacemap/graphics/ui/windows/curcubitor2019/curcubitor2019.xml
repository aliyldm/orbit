<?xml version="1.0" encoding="UTF-8"?>

<root>
    <libraries>
        <library id="gameclientCommonUI"/>
        <library id="chatWindowUIAssets"/>

    </libraries>

    <textstyle
            name="curcubitor_status_message"
            textColor="0xffe103"
            type="dynamic"
            fontSize="10"
            autoSize="left"
            wordWrap="true"
            multiline="true"
            embedFonts="false"
            fontName="Verdana"
            align="left"/>

    <textstyle
            name="curcubitor_status_timer"
            textColor="0xffe103"
            type="dynamic"
            fontSize="10"
            autoSize="right"
            wordWrap="true"
            multiline="true"
            embedFonts="false"
            fontName="Verdana"
            align="right"/>

    <textstyle
            name="curcubitor_message_left"
            textColor="0xfefefe"
            type="dynamic"
            fontSize="10"
            autoSize="left"
            wordWrap="true"
            multiline="true"
            embedFonts="false"
            fontName="Verdana"
            align="left"/>

    <textstyle
            name="curcubitor_progress_right"
            textColor="0xfefefe"
            type="dynamic"
            fontSize="10"
            autoSize="right"
            wordWrap="true"
            multiline="true"
            embedFonts="false"
            fontName="Verdana"
            align="right"/>


    <container name="root" width="450" height="205" mouseEnabled="false" mouseChildren="true">
        <container name="main" visible="true" width="400" marginLeft="25" marginRight="25" marginTop="10"
                   height="190"
                   alignX="left">

            <container name="top" width="400" marginLeft="0" marginRight="0" marginTop="0"
            registeredSkinName="commonui_darklayer" height="120" alignX="center">
                <container name="curcubitor_status_msg" width="360" marginLeft="20" height="10" marginRight="20" alignX="left">
                    <label name="curcubitor_status_message" text="localize:curcubitor_status_spawning" registeredTextStyleName="curcubitor_status_message"
                           marginTop="20" registeredSkinName="commonui_default_label" autoSizeWidth="true"/>
                    <label name="curcubitor_timer" text="testRight" registeredTextStyleName="curcubitor_status_timer" marginTop="20"
                           registeredSkinName="commonui_default_label" autoSizeWidth="true" alignX="right"/>
                </container>
                <coreponent registeredSkinName="commonui_horizontal_divider" height="4" width="400" marginTop="55"/>
                <container name="left" width="300" height="120" marginLeft="20" marginTop="75">
                    <label name = "curcubitor_countdown" text="localize:curcubitor_countdown_npc" registeredSkinName="commonui_default_label"
                           autoSizeWidth="true" registeredTextStyleName="curcubitor_message_left"/>
                </container>
                <container name="right" width="200" height="120" marginRight="20" marginTop="75" alignX="right">
                    <label name="curcubitor_progress" autoSizeWidth="true" registeredSkinName="commonui_default_label"
                           text="999" registeredTextStyleName="curcubitor_progress_right"/>
                </container>
            </container>
            <container name="bottom" width="400" marginLeft="0" marginRight="0" marginTop="130"
                       height="80" alignX="center">
                <label text="localize:curcubitor_event_description"
                       registeredTextStyleName="curcubitor_message_left" alignX="left" alignY="top" marginLeft="20"
                       registeredSkinName="commonui_default_label" width="360" autoSizeTextHeight="true"/>
            </container>
        </container>
    </container>
</root>
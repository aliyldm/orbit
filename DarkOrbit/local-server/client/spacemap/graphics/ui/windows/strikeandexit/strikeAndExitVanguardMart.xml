<?xml version="1.0" encoding="UTF-8"?>

<root>

       <!-- LIBS -->
       <libraries>
              <library id="gameclientCommonUI"/>
              <library id="battlePass"/>
       </libraries>

       <!-- TEXT STYLES -->

       <textstyle name="vipmerchexchange_timer" textColor="0xff9900" type="dynamic" fontSize="11" autoSize="center" wordWrap="false" multiline="false" embedFonts="false" fontName="Verdana" align="center"/>

       <textstyle name="sae_shop_header" textColor="0xffffff" type="dynamic" fontSize="10" autoSize="left" wordWrap="false" multiline="false" embedFonts="false" fontName="Verdana" bold="true" align="left"/>

       <textstyle name="sae_shop_item_description" textColor="0xffffff" type="dynamic" fontSize="10" autoSize="right" wordWrap="true" multiline="true" embedFonts="false" fontName="Verdana" bold="false" align="left"/>

       <textstyle name="sae_shop_item_limit" textColor="0xffffff" type="dynamic" fontSize="10" autoSize="left" wordWrap="false" multiline="false" embedFonts="false" fontName="Verdana" bold="false" align="left"/>

       <textstyle name="sae_shop_cost_right" textColor="0xffffff" type="dynamic" fontSize="10" autoSize="right" wordWrap="false" multiline="false" embedFonts="false" fontName="Verdana" align="right"/>

       <textstyle name="sae_shop_overview_headine" textColor="0xffbf13" type="dynamic" fontSize="11" autoSize="left" wordWrap="false" multiline="false" embedFonts="false" fontName="Verdana" bold="true" align="left"/>

       <textstyle name="vipmerchexchange_description" textColor="0xffffff" type="dynamic" fontSize="11" autoSize="right" wordWrap="true" multiline="true" embedFonts="false" fontName="Verdana" align="left"/>


       <textstyle name="vipmerchexchange_pack" textColor="0xff9900" type="dynamic" fontSize="10" autoSize="left" wordWrap="false" multiline="false" embedFonts="false" fontName="Verdana" align="left"/>


       <!-- SKIN -->
       <skin name="cost_item_bg" classname="BasicSkin">
              <layer classname="FilledBoxLayer" fillColor="0x2b2e31" fillAlpha="1">normal</layer>
       </skin>

       <skin name="sae_shop_scrollbar_bg" classname="FadableButtonSkin">
              <layer classname="FilledBoxLayer" fillColor="0x0" fillAlpha="0.3">normal</layer>
       </skin>

       <skin name="sae_shop_yellowlayer" classname="BasicSkin">
              <layer classname="FilledBoxLayer" fillColor="0x999900" fillAlpha="0.3">normal</layer>
       </skin>

       <skin name="sae_shop_exchange_icon_bg" classname="BasicSkin" library="battlePass">
              <layer classname="BitmapLayer" libraryID="item_bg">normal</layer>
       </skin>

       <skin name="sae_shop_exchange_icon_bg_special" classname="BasicSkin" library="battlePass">
              <layer classname="BitmapLayer" libraryID="item_bg_yellow">normal</layer>
       </skin>

       <skin name="sae_shop_exchange_icon_btn" classname="FadableButtonSkin">
              <layer classname="FilledBoxLayer" fillColor="0x0" fillAlpha="0">normal</layer>
       </skin>

       <skin name="sae_shop_exchange_desscription_bg" classname="BasicSkin" library="battlePass">
              <layer classname="BitmapLayer" libraryID="frame_bp-exchange_blue">normal</layer>
       </skin>

       <skin name="sae_shop_exchange_desscription_bg_special" classname="BasicSkin" library="battlePass">
              <layer classname="BitmapLayer" libraryID="frame_bp-exchange_yellow">normal</layer>
       </skin>

       <skin name="vip_merchant_exchange_scrollbar_bg" classname="FadableButtonSkin">
              <layer classname="FilledBoxLayer" fillColor="0x0" fillAlpha="0.3">normal</layer>
       </skin>

       <!-- TEMPLATES -->
       <template name="STRIKE_AND_EXIT_VANGUARD_MART">
              <container name="mart" autoSizeWidth="true" autoWidthMode="parent" autoSizeHeight="true" autoHeightMode="parent">

                     <coreponent autoSizeWidth="true" height="2" marginTop="30" registeredSkinName="commonui_horizontal_divider"/>

                     <coreponent name="top_bg"
                                    marginTop="36"
                                    marginLeft="9"                                    
                                     width="550" height="168"  visible="true"  registeredSkinName="commonui_darklayer" />


                     <container name="top" width="550" height="180" autoSizeWidth="false" autoSizeHeight="false" alignX="center" marginTop="40">

                            <label name="vip_info" text="" width="440" height="30" autoSizeWidth="false" autoSizeHeight="false" alignX="center" registeredTextStyleName="vipmerchexchange_description" registeredSkinName="commonui_default_label"/>

                            <label text="localize:window_vip-exchange_packs" width="490" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="left" marginTop="40" registeredTextStyleName="vipmerchexchange_description" registeredSkinName="commonui_default_label" visible="false"/>



                            <button name="buy_btn" text="localize:ttip_menu_buy_now" textMarginY="1" width="150" height="30" autoSizeWidth="false" autoSizeHeight="false" alignX="center" alignY="bottom" marginBottom="60" registeredSkinName="commonui_scale9_button_green" visible="false" />
                            <button name="un_buy_btn" text="localize:strikeandexit_store_available" textMarginY="1" width="150" height="30" autoSizeWidth="false" autoSizeHeight="false" alignX="center" alignY="bottom" marginBottom="60" registeredSkinName="commonui_scale9_button_green" visible="false" />

                            <label name="countdown_timer" text="21d 02h 02m" width="540" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="center" alignY="bottom" marginBottom="40" registeredTextStyleName="vipmerchexchange_timer" registeredSkinName="commonui_default_label"/>
                     </container>

                     <coreponent autoSizeWidth="true" height="2" marginTop="208" registeredSkinName="commonui_horizontal_divider"/>

                     <container name="main" width="550" height="300" autoSizeWidth="false" autoSizeHeight="false" marginTop="220" alignX="center" visible="false">

                            <coreponent visible="false" name="bg" width="30" height="30" autoSizeWidth="false" autoSizeHeight="false" marginLeft="5" marginTop="5" registeredSkinName="cost_item_bg">
                            </coreponent>

                            <coreponent name="icon" width="30" height="30" autoSizeWidth="false" autoSizeHeight="false" marginLeft="5" marginTop="5"/>

                            <label name="name" width="420" height="10" autoSizeWidth="false" autoSizeHeight="false" marginTop="20" marginLeft="40" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label" text=""/>


                            <label name="amount" width="420" height="10" autoSizeWidth="false" autoSizeHeight="false" marginTop="20" marginLeft="120" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label" text="0"/>


                            <container marginLeft="8" name="bottom" width="550" height="260" autoSizeWidth="false" autoSizeHeight="false" marginTop="40">

                                   <label text="localize:strikeandexit_store_item" width="300" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="left" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label"/>

                                   <label text="localize:strikeandexit_store_period" width="300" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="left" marginLeft="90" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label"/>

                                   <label text="localize:window_vip-exchange_cost" width="200" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="left" marginLeft="330" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label"/>

                                   <container name="exchange" width="550" height="240" autoSizeWidth="false" autoSizeHeight="false" marginTop="20">

                                          <itemlist name="list" width="550" height="240" autoSizeWidth="false" autoSizeHeight="false" layout="vertical" itemGap="0" mouseEnabled="true" mouseChildren="true" cacheSkinMaskAsBitmap="false" registeredSkinName="commonui_list_mask">

                                                 <itemrenderer width="540" height="80" autoSizeWidth="false" autoSizeHeight="false" itemGap="0" mouseEnabled="true" mouseChildren="true">

                                                        <coreponent name="bg" width="540" height="80" autoSizeWidth="false" autoSizeHeight="false" registeredSkinName="commonui_darklayer"/>

                                                        <coreponent name="bg_special" width="540" height="80" autoSizeWidth="false" autoSizeHeight="false" registeredSkinName="sae_shop_yellowlayer"/>

                                                        <container name="icon" width="70" height="70" autoSizeWidth="false" autoSizeHeight="false" marginTop="5" marginLeft="7">
                                                               <coreponent name="bg" width="70" height="70" autoSizeWidth="false" autoSizeHeight="false" registeredSkinName="sae_shop_exchange_icon_bg"/>

                                                               <coreponent name="bg_special" width="70" height="70" autoSizeWidth="false" autoSizeHeight="false" registeredSkinName="sae_shop_exchange_icon_bg_special"/>

                                                               <coreponent name="icon" width="45" height="45" autoSizeWidth="false" autoSizeHeight="false" alignX="center" alignY="center"/>

                                                               <button name="btn" width="45" height="45" autoSizeWidth="false" autoSizeHeight="false" alignX="center" alignY="center" registeredSkinName="sae_shop_exchange_icon_btn"/>

                                                               <label name="amount" width="220" height="10" autoSizeWidth="false" autoSizeHeight="false" marginTop="2" marginLeft="5" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label" text="100"/>

                                                        </container>

                                                        <coreponent name="vertical_divider_1" width="1" height="80" marginLeft="85"/>

                                                        <container name="item" width="260" height="80" autoSizeWidth="false" autoSizeHeight="false" marginLeft="90">
                                                               <coreponent name="bg" width="240" height="70" autoSizeWidth="false" autoSizeHeight="false" alignX="center " alignY="center" registeredSkinName="sae_shop_exchange_desscription_bg"/>

                                                               <coreponent name="bg_special" width="240" height="70" autoSizeWidth="false" autoSizeHeight="false" alignY="center" registeredSkinName="sae_shop_exchange_desscription_bg_special"/>

                                                               <label name="name" width="220" height="10" autoSizeWidth="false" autoSizeHeight="false" marginTop="20" marginLeft="5" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label"/>

                                                               <label name="description" width="220" height="10" autoSizeWidth="false" autoSizeHeight="false" marginTop="25" marginLeft="5" registeredTextStyleName="sae_shop_item_description" registeredSkinName="commonui_default_label"/>

                                                               <label name="limit_label" text="localize:strikeandexit_store_available" width="100" height="10" autoSizeWidth="false" autoSizeHeight="false" alignY="bottom" marginBottom="20" marginLeft="5" registeredTextStyleName="sae_shop_item_limit" registeredSkinName="commonui_default_label"/>

                                                               <label name="limit" width="100" height="10" autoSizeWidth="false" autoSizeHeight="false" alignY="bottom" marginLeft="150" marginBottom="20" registeredTextStyleName="sae_shop_item_limit" registeredSkinName="commonui_default_label"/>
                                                        </container>

                                                        <coreponent name="vertical_divider_2" width="1" height="80" alignX="right" marginRight="205"/>

                                                        <container name="cost" width="190" height="80" autoSizeWidth="false" autoSizeHeight="false" alignX="right" marginRight="10">

                                                               <coreponent visible="false" name="bg" width="30" height="30" autoSizeWidth="false" autoSizeHeight="false" marginLeft="5" marginTop="5" registeredSkinName="cost_item_bg">
                                                               </coreponent>

                                                               <coreponent name="icon" width="30" height="30" autoSizeWidth="false" autoSizeHeight="false" marginLeft="5" marginTop="5"/>

                                                               <label name="item" width="50" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="right" marginTop="12" registeredTextStyleName="sae_shop_cost_right" registeredSkinName="commonui_default_label"/>

                                                               <label name="amount" width="150" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="right" marginTop="24" registeredTextStyleName="sae_shop_cost_right" registeredSkinName="commonui_default_label"/>


                                                               <button name="exchange_btn" localizedText="window_vip-exchange_exchange" width="100" height="30" autoSizeWidth="false" autoSizeHeight="false" alignX="center" alignY="bottom" marginBottom="5" registeredSkinName="commonui_scale9_button_green"/>
                                                        </container>

                                                        <coreponent name="item_end_divider" width="540" height="1" alignY="bottom"/>


                                                 </itemrenderer>
                                          </itemlist>
                                          <scrollbar name="scroll_bar" width="10" autoSizeHeight="true" direction="vertical" marginTop="0" marginBottom="0" marginRight="0" alignX="right" registeredSkinName="sae_shop_scrollbar_bg">
                                                 <button name="buttonSlider" width="8" height="10" alignX="center" registeredSkinName="commonui_scrollbar_slider"/>
                                          </scrollbar>
                                          <bind source="scroll_bar" target="list" type="scrollcontainer"/>
                                   </container>
                            </container>
                     </container>

                     <container name="unavailable" width="550" height="300" autoSizeWidth="false" autoSizeHeight="false" marginTop="220" alignX="center">

                            <coreponent visible="false" name="bg" width="30" height="30" autoSizeWidth="false" autoSizeHeight="false" marginLeft="5" marginTop="5" registeredSkinName="cost_item_bg">
                            </coreponent>

                            <coreponent name="icon" width="30" height="30" autoSizeWidth="false" autoSizeHeight="false" marginLeft="5" marginTop="5"/>

                            <label name="name" width="420" height="10" autoSizeWidth="false" autoSizeHeight="false" marginTop="20" marginLeft="40" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label" text=""/>


                            <label name="amount" width="420" height="10" autoSizeWidth="false" autoSizeHeight="false" marginTop="20" marginLeft="120" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label" text="0"/>


                            <container marginLeft="8"  name="bottom" width="550" height="260" autoSizeWidth="false" autoSizeHeight="false" marginTop="40">

                                   <label text="localize:strikeandexit_store_item" width="300" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="left" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label"/>

                                   <label text="localize:strikeandexit_store_period" width="300" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="left" marginLeft="90" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label"/>

                                   <label text="localize:window_vip-exchange_cost" width="200" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="left" marginLeft="330" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label"/>

                                   <container  name="exchange" width="540" height="240" autoSizeWidth="false" autoSizeHeight="false" marginTop="20">

                                          <itemlist name="list" width="540" height="240" autoSizeWidth="false" autoSizeHeight="false" layout="vertical" itemGap="0" mouseEnabled="true" mouseChildren="true" cacheSkinMaskAsBitmap="false" registeredSkinName="commonui_list_mask">

                                                 <itemrenderer width="540" height="80" autoSizeWidth="false" autoSizeHeight="false" itemGap="0" mouseEnabled="true" mouseChildren="true">

                                                        <coreponent  name="bg" width="540" height="80" autoSizeWidth="false" autoSizeHeight="false" registeredSkinName="commonui_darklayer"/>

                                                        <coreponent name="bg_special" width="540" height="80" autoSizeWidth="false" autoSizeHeight="false" registeredSkinName="sae_shop_yellowlayer"/>

                                                        <container name="icon" width="70" height="70" autoSizeWidth="false" autoSizeHeight="false" marginTop="5" marginLeft="7">
                                                               <coreponent name="bg" width="70" height="70" autoSizeWidth="false" autoSizeHeight="false" registeredSkinName="sae_shop_exchange_icon_bg"/>

                                                               <coreponent name="bg_special" width="70" height="70" autoSizeWidth="false" autoSizeHeight="false" registeredSkinName="sae_shop_exchange_icon_bg_special"/>

                                                               <coreponent name="icon" width="45" height="45" autoSizeWidth="false" autoSizeHeight="false" alignX="center" alignY="center"/>

                                                               <button name="btn" width="45" height="45" autoSizeWidth="false" autoSizeHeight="false" alignX="center" alignY="center" registeredSkinName="sae_shop_exchange_icon_btn"/>

                                                               <label name="amount" width="220" height="10" autoSizeWidth="false" autoSizeHeight="false" marginTop="2" marginLeft="5" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label" text="100"/>

                                                        </container>

                                                        <coreponent name="vertical_divider_1" width="1" height="80" marginLeft="85"/>

                                                        <container name="item" width="260" height="80" autoSizeWidth="false" autoSizeHeight="false" marginLeft="90">
                                                               <coreponent name="bg" width="240" height="70" autoSizeWidth="false" autoSizeHeight="false" alignX="center " alignY="center" registeredSkinName="sae_shop_exchange_desscription_bg"/>

                                                               <coreponent name="bg_special" width="240" height="70" autoSizeWidth="false" autoSizeHeight="false" alignY="center" registeredSkinName="sae_shop_exchange_desscription_bg_special"/>

                                                               <label name="name" width="220" height="10" autoSizeWidth="false" autoSizeHeight="false" marginTop="20" marginLeft="5" registeredTextStyleName="sae_shop_header" registeredSkinName="commonui_default_label"/>

                                                               <label name="description" width="220" height="10" autoSizeWidth="false" autoSizeHeight="false" marginTop="25" marginLeft="5" registeredTextStyleName="sae_shop_item_description" registeredSkinName="commonui_default_label"/>

                                                               <label name="limit_label" text="localize:strikeandexit_store_available" width="100" height="10" autoSizeWidth="false" autoSizeHeight="false" alignY="bottom" marginBottom="20" marginLeft="5" registeredTextStyleName="sae_shop_item_limit" registeredSkinName="commonui_default_label"/>

                                                               <label name="limit" width="100" height="10" autoSizeWidth="false" autoSizeHeight="false" alignY="bottom" marginLeft="150" marginBottom="20" registeredTextStyleName="sae_shop_item_limit" registeredSkinName="commonui_default_label"/>
                                                        </container>

                                                        <coreponent name="vertical_divider_2" width="1" height="80" alignX="right" marginRight="205"/>

                                                        <container name="cost" width="190" height="80" autoSizeWidth="false" autoSizeHeight="false" alignX="right" marginRight="10">

                                                               <coreponent visible="false" name="bg" width="30" height="30" autoSizeWidth="false" autoSizeHeight="false" marginLeft="5" marginTop="5" registeredSkinName="cost_item_bg">
                                                               </coreponent>

                                                               <coreponent  name="icon" width="30" height="30" autoSizeWidth="false" autoSizeHeight="false" marginLeft="5" marginTop="5"/>

                                                               <label name="item" width="50" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="right" marginTop="12" registeredTextStyleName="sae_shop_cost_right" registeredSkinName="commonui_default_label"/>

                                                               <label name="amount" width="150" height="10" autoSizeWidth="false" autoSizeHeight="false" alignX="right" marginTop="24" registeredTextStyleName="sae_shop_cost_right" registeredSkinName="commonui_default_label"/>


                                                               <button name="lock_exchange_btn" localizedText="window_vip-exchange_exchange" width="100" height="30" autoSizeWidth="false" autoSizeHeight="false" alignX="center" alignY="bottom" marginBottom="5" registeredSkinName="commonui_scale9_button_green" visible="true" enabled="false"/>
                                                        </container>

                                                        <coreponent name="item_end_divider" width="540" height="1" alignY="bottom"/>


                                                 </itemrenderer>
                                          </itemlist>
                                          <scrollbar name="scroll_bar" width="10" autoSizeHeight="true" direction="vertical" marginTop="0" marginBottom="0" marginRight="0" alignX="right" registeredSkinName="sae_shop_scrollbar_bg">

                            </container>
                     </container>





              </container>
       </template>

       <!-- CONTENT -->
       <container name="root" width="535" height="500" autoSizeWidth="false" autoSizeHeight="false" mouseEnabled="false" mouseChilderen="true">
              <reference template="STRIKE_AND_EXIT_VANGUARD_MART"/>
       </container>
</root>

<root>
    <libraries>
        <library id="gameclientCommonUI"/>
        <library id="miniClientReward"/>
    </libraries>
    <textstyle name="expedition_style1"
               textColor="0xF1FBEC"
               fontSize="12"
               type="dynamic"
               fontName="EurostileHeaFl"
               embedFonts="true"
               multiline="true"
               wordWrap="true"
               autoSize="left"/>
    <textstyle name="expedition_style2"
               textColor="0xF1FBEC"
               fontSize="14"
               type="dynamic"
               fontName="EurostileHeaFl"
               embedFonts="true"
               multiline="true"
               wordWrap="true"
               autoSize="left"/>

    <textstyle name="expedition_style3"
               textColor="0xF1FBEC"
               fontSize="12"
               type="dynamic"
               fontName="EurostileHeaFl"
               embedFonts="true"
               multiline="true"
               wordWrap="true"
               autoSize="right"
               align="right"/>

    <skin name="reward_mark" classname="BasicSkin" library="miniClientReward">
        <layer classname="BitmapLayer" libraryID="reward_checkmark">normal</layer>
    </skin>

    <skin name="reward_slot_bg" library="gameclientCommonUI" classname="BasicSkin">
        <layer classname="BitmapLayer" libraryID="input_background_blue" scale9grid="4,4,6,5">normal</layer>
    </skin>

    <template name="expeditionTab1">
        <container name="tab1" autoSizeWidth="true" autoSizeHeight="true" width="850" height="500">
            <label name="currentLevelLabel"
                   autoSizeWidth="false" autoSizeHeight="false"
                   alignX="left" alignY="top"
                   width="180" height="20"
                   marginLeft="20" marginTop="20"
                   text="localize:window_dse_current_level"
                   registeredTextStyleName="expedition_style1"
                   registeredSkinName="commonui_default_label"/>

            <label name="highestLevelLabel"
                   autoSizeWidth="false" autoSizeHeight="false"
                   alignX="left" alignY="top"
                   width="180" height="20"
                   marginLeft="20" marginTop="40"
                   text="localize:window_dse_level_clear"
                   registeredTextStyleName="expedition_style1"
                   registeredSkinName="commonui_default_label"/>

            <label name="timeLimitLabel"
                   autoSizeWidth="false" autoSizeHeight="false"
                   alignX="left" alignY="top"
                   width="180" height="20"
                   marginLeft="20" marginTop="60"
                   text="Time Limited: 00:05:00"
                   registeredTextStyleName="expedition_style1"
                   registeredSkinName="commonui_default_label"/>

            <label name="conditionLabel1"
                   autoSizeWidth="false" autoSizeHeight="false"
                   alignX="left" alignY="top"
                   width="500" height="20"
                   marginLeft="20" marginTop="80"
                   text="Winning Conditions: destroy all enemies."
                   registeredTextStyleName="expedition_style1"
                   registeredSkinName="commonui_default_label"/>

            <label name="conditionLabel2"
                   autoSizeWidth="false" autoSizeHeight="false"
                   alignX="left" alignY="top"
                   width="500" height="20"
                   marginLeft="20" marginTop="100"
                   text="Fallure Conditions: Your ship is destroyed."
                   registeredTextStyleName="expedition_style1"
                   registeredSkinName="commonui_default_label"/>

            <container name="reward_container" alignX="left" alignY="top" marginLeft="30" marginTop="160" >
                <coreponent name="reward_bg" width="833" height="170"
                            autoSizeWidth="false" autoSizeHeight="false"
                            alignX="left" alignY="top"
                            marginLeft="-20" marginTop="-30" mouseEnabled="false"
                            registeredSkinName="commonui_darklayer"/>


                <itemlist name="list" width="810" height="200" autoSizeWidth="false" autoSizeHeight="false"
                          layout="horizontal" itemGap="0" mouseEnabled="true" mouseChildren="true"
                          cacheSkinMaskAsBitmap="false" >

                    <itemrenderer width="270" height="200" autoSizeWidth="false"
                                  autoSizeHeight="false" itemGap="0"
                                  mouseEnabled="true" mouseChildren="true">

                        <coreponent name="reward_icon_bg"
                                    width="102" height="102"
                                    autoSizeWidth="false" autoSizeHeight="false"
                                    alignX="left" alignY="top"
                                    marginLeft="0" marginTop="0"
                                    registeredSkinName="reward_slot_bg"/>

                        <coreponent name="reward_item_icon" width="100" height="100"
                                    autoSizeWidth="false" autoSizeHeight="false"
                                    alignX="left" alignY="top"
                                    marginLeft="1" marginTop="1" mouseEnabled="true"/>

                        <label name="reward_item_num" registeredSkinName="commonui_default_label"
                               registeredTextStyleName="expedition_style1"
                               alignX="left" alignY="top"
                               marginLeft="108" marginTop="60"
                               width="160"
                               autoSizeTextHeight="true"
                               text="50"/>

                        <coreponent name="checkmark"
                                    alignX="left" alignY="top"
                                    marginLeft="30" marginTop="30"
                                    visible="true"
                                    registeredSkinName="reward_mark" mouseEnabled="false"/>


                        <label name="reward_first_clear" text="FIRST CLEAR"
                               registeredSkinName="commonui_default_label"
                               alignX="left" alignY="top"
                               marginLeft="108" marginTop="30"
                               width="135"
                               autoSizeTextHeight="true"
                               registeredTextStyleName="expedition_style1"/>
                    </itemrenderer>
                </itemlist>

                <scrollbar name="scroll_bar" width="800"
                           direction="horizontal"
                           alignX="left" alignY="top"
                           marginLeft="0" marginTop="110"
                           registeredSkinName="commonui_scrollbar_bgnd">
                    <button name="buttonSlider" width="8" height="10" alignX="center"
                            registeredSkinName="commonui_scrollbar_slider"/>
                </scrollbar>
                <bind source="scroll_bar" target="list" type="scrollcontainer"/>
            </container>


            <!-- item -->
            <container name="cost_container" alignX="left" alignY="top"
                       marginLeft="20" marginTop="330">

                <coreponent name="cost_item_icon" width="50" height="50"
                            autoSizeWidth="false" autoSizeHeight="false"
                            alignX="left" alignY="top"
                            marginLeft="20" marginTop="0"
                            mouseEnabled="true"/>

                <label name="cost_name_label" registeredSkinName="commonui_default_label"
                       registeredTextStyleName="expedition_style2"
                       alignX="left" alignY="top"
                       marginLeft="80" marginTop="20" width="180"
                       autoSizeTextHeight="true"
                       text="item name"/>


                <label name="cost_num_label" registeredSkinName="commonui_default_label"
                       registeredTextStyleName="expedition_style3"
                       alignX="left" alignY="top"
                       marginLeft="200" marginTop="20" width="180"
                       autoSizeTextHeight="true"
                       text="99999"/>

                <coreponent name="cost_tips"
                            alignX="left" alignY="top"
                            marginLeft="385" marginTop="20"
                            visible="true"
                            registeredSkinName="commonui_info_button"
                            mouseEnabled="true"/>


            </container>


            <coreponent name="info_tips"
                        alignX="left" alignY="top"
                        marginLeft="20" marginTop="400"
                        registeredSkinName="commonui_info_button" mouseEnabled="false"/>


            <label name="info_label"
                   autoSizeWidth="false" autoSizeHeight="true"
                   width="760" height="70"
                   alignX="left" alignY="top"
                   marginLeft="47" marginTop="400"
                   text=""
                   registeredTextStyleName="expedition_style2"
                   registeredSkinName="commonui_default_label"/>


        </container>


    </template>
    <container name="root" width="850" height="500" autoSizeWidth="false" autoSizeHeight="false"
               mouseEnabled="false" mouseChildren="true">
        <reference template="expeditionTab1"/>
    </container>
</root>

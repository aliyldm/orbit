<?xml version="1.0" encoding="UTF-8"?>

<root>
	<!-- LIBS -->
	<libraries>
		<library id="gameclientCommonUI" />
		<library id="settingsWindowFUI" />
		<library id="seasonPass_asset"/>
	</libraries>

	<!-- TEXT STYLES -->
	<textstyle 	name           = "popup_whiteTextStyleButton"
				  textColor      = "0xFFFFFF"
				  type           = "dynamic"
				  selectable     = "false"
				  fontName       = "EurostileTHea"
				  align		   = "center"
				  fontSize	   = "16"
	/>

	<textstyle
			name="popup_info_textstyle"
			textColor="0xffffff"
			type="dynamic"
			fontSize="10"
			autoSize="center"
			wordWrap="true"
			multiline="true"
			embedFonts="false"
			fontName="Verdana"
			align="center"/>

	<textstyle
			name="popup_save_textstyle"
			textColor="0x999898"
			type="dynamic"
			fontSize="8"
			autoSize="left"
			wordWrap="true"
			multiline="true"
			embedFonts="false"
			fontName="Verdana"
			align="left"/>

	<!-- SKINS -->
	<skin name="confirmation_label_skin" classname="LabelSkin" />

	<skin name="popup_label_button_green" classname="FadableButtonSkin" library="settingsWindowFUI" >
		<layer classname="BitmapLayer" libraryID="btn_green_normal" >normal</layer>
		<layer classname="BitmapLayer" libraryID="btn_green_hover" >over</layer>
		<layer classname="BitmapLayer" libraryID="btn_inactive" >disabled</layer>
	</skin>
	<skin name="popup_label_button_red" classname="FadableButtonSkin" library="settingsWindowFUI" >
		<layer classname="BitmapLayer" libraryID="btn_red_normal" >normal</layer>
		<layer classname="BitmapLayer" libraryID="btn_red_hover" >over</layer>
		<layer classname="BitmapLayer" libraryID="btn_inactive" >disabled</layer>
	</skin>

	<skin name="season_pass_icon_gold" classname="BasicSkin" library="seasonPass_asset">
		<layer classname="BitmapLayer" libraryID="icon_pass_gold_big">normal</layer>
	</skin>

	<!-- CONTENT -->
	<container
			name="contentContainer"
			mouseEnabled="false"
			width="270"
			height="220">

		<coreponent name="icon"
					width="116" height="86" autoSizeWidth="false" autoSizeHeight="false"
					alignX="center" marginTop="20"
					registeredSkinName="season_pass_icon_gold"/>

		<label
				name="label"
				marginTop="130"
				autoSizeWidth="true"
				localizedText="sp_popup_buy_gold-pass"
				alignX="left"
				useHTML="true"
				height="15"
				registeredSkinName="confirmation_label_skin"
				registeredTextStyleName="popup_info_textstyle" />

		<button name="okButton" width="100" height="30" marginTop="195" alignX="left" text="localize:label_trade_window_shop_button" registeredSkinName="popup_label_button_green" registeredTextStyleName="commonui_button_whitetxt_16pt"/>
		<button name="cancelButton" width="100"  height="30" marginTop="195" marginLeft="150" alignX="left" text="localize:btn_cancel" registeredSkinName="popup_label_button_red" registeredTextStyleName="commonui_button_whitetxt_16pt"/>

	</container>
	<!-- CONTENT -->
</root>
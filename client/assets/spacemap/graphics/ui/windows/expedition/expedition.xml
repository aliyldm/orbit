<?xml version="1.0" encoding="UTF-8"?>
<root>
    <!-- LIBS -->
    <libraries>
        <library id="gameclientCommonUI"/>
    </libraries>
    <!-- TEXT STYLES -->
    <textstyle name="expedition_inactive_message" textColor="0xfefefe" type="dynamic"
               fontSize="14" autoSize="center" wordWrap="true" multiline="true"
               embedFonts="true" fontName="EurostileHeaFl" align="center"/>

    <textstyle name="tab_textstyle"
               textColor="0x6FB2CB"
               type="dynamic"
               fontSize="9"
               autoSize="center"
               wordWrap="true"
               multiline="true"
               align="center"
               embedFonts="false"
               fontName="Verdana"/>

    <textstyle name="tab_textstyle_active"
               textColor="0xE9E2C0"
               type="dynamic"
               fontSize="9"
               autoSize="center"
               wordWrap="true"
               multiline="true"
               align="center"
               embedFonts="false"
               fontName="Verdana"
               glowFilter='{"color":"0xE9CB3C", "blurX":"1.1", "blurY":"1.1", "strength":"2", "quality":"2"}'/>
    <!-- CONTENT -->

    <container name="root" width="845" height="500" mouseEnabled="false" mouseChildren="true">
        <container name="tabbarContainer" height="20" width="478" marginLeft="389" pixelSnapping="true">
            <itemlist name="tabsItemlist" layout="horizontal" autoSizeWidth="true" itemGap="1" height="20"
                      mouseEnabled="true" mouseChildren="true" cacheSkinMaskAsBitmap="false"
                      registeredSkinName="commonui_list_mask">
                <itemrenderer height="15" width="115" autoSizeWidth="false" mouseEnabled="true" mouseChildren="true">
                    <button name="tab" mouseEnabled="true" autoSizeWidth="true" autoSizeHeight="true"
                            mouseChildren="true" registeredSkinName="commonui_tabbarbutton"/>
                    <button name="tab_selected" mouseEnabled="true" autoSizeWidth="true" visible="false"
                            autoSizeHeight="true" mouseChildren="true" registeredSkinName="commonui_tabbarbutton"/>
                    <label name="tabLabel" y="-1" text="?" width="113" mouseEnabled="false" mouseChildren="false"
                           autoSizeWidth="true" registeredSkinName="commonui_default_label"
                           registeredTextStyleName="tab_textstyle"/>
                </itemrenderer>
            </itemlist>
        </container>
    </container>
    <container name="inactive" width="860" height="500" autoSizeWidth="false" autoSizeHeight="false">
       <coreponent name="cogBigContainer" alignY="center" alignX="center" x="-20" y="-30" alpha="1" mouseEnabled="false" mouseChildren="false">
            <movieclip name="cogBig" library="gameclientCommonUI" libraryID="cog_big"/>
        </coreponent>
        <coreponent name="cogSmallContainer" alignY="center" alignX="center" x="27" y="27" alpha="1" mouseEnabled="false" mouseChildren="false">
            <movieclip name="cogSmall" library="gameclientCommonUI" libraryID="cog_small"/>
        </coreponent>

        <label text="localize:window_dse_loading" width="700" alignY="top" alignX="center" autoSizeWidth="false"
               height="20" autoSizeHeight="false" marginTop="340"
               registeredTextStyleName="expedition_inactive_message" registeredSkinName="commonui_default_label"/>
    </container>
    <!-- CONTENT -->
</root>
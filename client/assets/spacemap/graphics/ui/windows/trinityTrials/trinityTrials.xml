<template name="trinitytrials_tabbar">
        <container name="tabbarContainer"
                   width="687" height="15"
                   marginTop="0" marginLeft="136" pixelSnapping="true">
            <itemlist name="tabsItemlist"
                      width="687" height="15"
                      layout="horizontal" alignX="left" itemGap="0"
                      mouseEnabled="true" mouseChildren="true"
                      cacheSkinMaskAsBitmap="false" registeredSkinName="commonui_list_mask">
                <itemrenderer width="200" height="15" autoSizeWidth="false"
                              mouseEnabled="true" mouseChildren="true">
                    <button name="tab"
                            autoSizeWidth="true" autoSizeHeight="true"
                            mouseEnabled="true" mouseChildren="true"
                            registeredSkinName="commonui_tabbarbutton"/>
                    <button name="tab_selected" visible="false"
                            autoSizeWidth="true"  autoSizeHeight="true"
                            mouseEnabled="true" mouseChildren="true"
                            registeredSkinName="commonui_tabbarbutton"/>
                    <label name="tabLabel" text="?"
                           autoSizeWidth="true" height="15" alignY="center"
                           mouseEnabled="false" mouseChildren="false"
                           registeredTextStyleName="trinitutrials_tab_center"  registeredSkinName="commonui_default_label"/>
                </itemrenderer>
            </itemlist>
        </container>
    </template>
<template name="trinitytrials">
	<coreponent name="main" width="728" height="460" autoSizeWidth="false" autoSizeHeight="false"
               mouseEnabled="false" mouseChilderen="true"/>
</template>

    <container name="root"
               width="728" height="460" autoSizeWidth="false" autoSizeHeight="false"
               mouseEnabled="false" mouseChilderen="true">
        <reference template="trinitytrials"/>
        <reference template="trinitytrials_tabbar"/>
    </container>
</root>

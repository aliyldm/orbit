<?xml version="1.0" encoding="UTF-8"?>

<root>
	<!-- LIBS -->
	<libraries>
		<library id="gameclientCommonUI" />
		<library id="settingsWindowFUI" />
	</libraries>
	<!-- TEXT STYLES -->


	<textstyle 	name           = "popup_whiteTextStyleButton"
				  textColor      = "0xFFFFFF"
				  type           = "dynamic"
				  selectable     = "false"
				  fontName       = "EurostileTHea"
				  align		   = "center"
				  fontSize	   = "16"
			/>

	<textstyle
			name="popup_info_left_textstyle"
			textColor="0x999898"
			type="dynamic"
			fontSize="10"
			wordWrap="true"
			multiline="true"
			embedFonts="false"
			fontName="Verdana"
			align="left"/>

	<textstyle
			name="popup_save_textstyle"
			textColor="0x999898"
			type="dynamic"
			fontSize="8"
			autoSize="left"
			wordWrap="true"
			multiline="true"
			embedFonts="false"
			fontName="Verdana"
			align="left"/>

	<skin name="confirmation_label_skin" classname="LabelSkin" />

	<skin name="popup_label_button_green" classname="FadableButtonSkin" library="settingsWindowFUI" >
		<layer classname="BitmapLayer" libraryID="btn_green_normal" >normal</layer>
		<layer classname="BitmapLayer" libraryID="btn_green_hover" >over</layer>
		<layer classname="BitmapLayer" libraryID="btn_inactive" >disabled</layer>
	</skin>
	<skin name="popup_label_button_red" classname="FadableButtonSkin" library="settingsWindowFUI" >
		<layer classname="BitmapLayer" libraryID="btn_red_normal" >normal</layer>
		<layer classname="BitmapLayer" libraryID="btn_red_hover" >over</layer>
		<layer classname="BitmapLayer" libraryID="btn_inactive" >disabled</layer>
	</skin>

<!--  -->
<!--  -->
<!--  -->	

<!--  -->
<!--  -->
<!--  -->


	<!-- CONTENT -->
	<container
		name="contentContainer"
		mouseEnabled="false"
		width="260"
		height="150">

		<label
				name="label"
				autoSizeWidth="true"
				localizedText="Synthesis_material_returned"
				alignX="left"
				marginLeft="20"
				alignY="top"
				marginTop="40"
				useHTML="true"
				width="220"
				height="100"
				registeredSkinName="confirmation_label_skin"
				registeredTextStyleName="popup_info_left_textstyle" />

		<button name="okButton" width="100" height="30" marginTop="130" marginLeft="20" alignX="left" text="localize:btn_ok" registeredSkinName="popup_label_button_green" registeredTextStyleName="commonui_button_whitetxt_16pt"/>
		<button name="cancelButton" width="100"  height="30" marginTop="130" marginRight="10" alignX="right" text="localize:btn_cancel" registeredSkinName="popup_label_button_red" registeredTextStyleName="commonui_button_whitetxt_16pt"/>

	</container>
	<!-- CONTENT -->
</root>
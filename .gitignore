# Runtime assets go in the downloadable release, rather than 1.5GB of Git history.
DarkOrbit/local-server/client/**
!DarkOrbit/local-server/client/**/
!DarkOrbit/local-server/client/do_img/global/bg_standard_mmo.jpg
!DarkOrbit/local-server/client/_host/do_img/global/companyChoose/gamelogo.png
!DarkOrbit/local-server/client/**/*.js
!DarkOrbit/local-server/client/**/*.xml
!DarkOrbit/local-server/client/**/*.css
!DarkOrbit/local-server/client/spacemap/main.swf
!DarkOrbit/local-server/client/spacemap/preloader.swf
!DarkOrbit/local-server/client/swf_global/inventory/inventory.swf
# Keep reviewed ActionScript/evidence in Git; heavy binary audit inputs ship separately.
DarkOrbit/local-server/decompiled/**
!DarkOrbit/local-server/decompiled/**/
!DarkOrbit/local-server/decompiled/**/*.as
!DarkOrbit/local-server/decompiled/**/evidence.json
!DarkOrbit/local-server/decompiled/gate-source-evidence/*.source.json
